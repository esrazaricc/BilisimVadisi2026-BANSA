digraph BANSA_ERD {
  graph [rankdir=LR, bgcolor="white", nodesep=0.35, ranksep=0.7, splines=ortho];
  node [shape=record, fontname="Arial", fontsize=9];
  edge [fontname="Arial", fontsize=8, arrowsize=0.7];

  banks [label="{BANKS|PK id\lname\lslug\l}"];
  sources [label="{SOURCE_PAGES|PK id\lFK bank_id\lurl\lcontent_hash\l}"];
  snapshots [label="{SOURCE_PAGE_SNAPSHOTS|PK id\lFK source_page_id\lcontent_hash\lcaptured_at\l}"];
  campaigns [label="{CAMPAIGNS|PK id\lFK bank_id\lFK source_page_id\lcampaign_name\lstatus\l}"];
  cfin [label="{CAMPAIGN_FINANCE_DETAILS|PK/FK campaign_id\lprofit_share\lamount\lmaturity\l}"];
  cbenefits [label="{CAMPAIGN_BENEFITS|PK id\lFK campaign_id\lbenefit_type\lamount/rate\l}"];
  caud [label="{CAMPAIGN_AUDIENCES|PK id\lFK campaign_id\laudience\l}"];
  cterms [label="{CAMPAIGN_INSTALLMENT_TERMS|PK id\lFK campaign_id\ltransaction amount\linstallments\l}"];
  cchanges [label="{CAMPAIGN_CHANGE_EVENTS|PK id\lFK campaign_id\lchange_type\lbefore/after\l}"];

  families [label="{PRODUCT_FAMILIES|PK id\lfamily_key\lfamily_name\l}"];
  products [label="{STANDARD_PRODUCTS|PK id\lFK bank_id\lFK family_id\lFK source_page_id\lproduct_name\l}"];
  am [label="{AMOUNT_MATURITY_RULES|PK id\lFK product_id\lmin/max amount\lmax maturity\l}"];
  cat [label="{CATEGORY_RULES|PK id\lFK product_id\lcategory\lmax installments\l}"];
  pricing [label="{PRICING_TIERS|PK id\lFK product_id\lmaturity\lprofit_share\lfee\l}"];
  fees [label="{FEE_RULES|PK id\lFK product_id\lfee_type\lamount/rate\l}"];
  offers [label="{OFFER_RULES|PK id\lFK product_id\lcondition\l}"];
  features [label="{PRODUCT_FEATURES|PK id\lFK product_id\lfeature_key\lfeature_value\l}"];
  pchanges [label="{PRODUCT_CHANGE_EVENTS|PK id\lFK product_id\lchange_type\lbefore/after\l}"];
  scan [label="{PRODUCT_SCAN_STATE|PK/FK product_id\lmissing_count\lpossible_removed\l}"];

  banks -> sources [label="1:N"];
  sources -> snapshots [label="1:N"];
  banks -> campaigns [label="1:N"];
  sources -> campaigns [label="1:N"];
  campaigns -> cfin [label="1:0..1"];
  campaigns -> cbenefits [label="1:N"];
  campaigns -> caud [label="1:N"];
  campaigns -> cterms [label="1:N"];
  campaigns -> cchanges [label="1:N"];

  banks -> products [label="1:N"];
  families -> products [label="1:N"];
  sources -> products [label="1:N"];
  products -> am [label="1:N"];
  products -> cat [label="1:N"];
  products -> pricing [label="1:N"];
  products -> fees [label="1:N"];
  products -> offers [label="1:N"];
  products -> features [label="1:N"];
  products -> pchanges [label="1:N"];
  products -> scan [label="1:0..1"];
}
